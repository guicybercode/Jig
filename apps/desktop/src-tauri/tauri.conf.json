{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLI Master",
  "version": "0.1.0",
  "identifier": "com.guicybercode.climaster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CLI Master",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local control center for CLI coding agents",
    "longDescription": "CLI Master coordinates locally installed coding-agent CLIs in Git-aware terminal sessions. It does not proxy agent traffic through a cloud service.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cli-masterd"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": null
    }
  }
}
