{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLI Master",
  "version": "0.1.0-beta.1",
  "identifier": "com.guicybercode.climaster",
  "build": {
    "beforeDevCommand": "cargo build -p cli-master-daemon && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -p cli-master-daemon --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CLI Master",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
