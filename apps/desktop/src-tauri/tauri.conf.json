{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jig",
  "version": "0.2.0",
  "identifier": "com.guicybercode.jig",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jig",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Terminals on a canvas for coding agents",
    "longDescription": "Jig hosts coding-agent CLIs in real terminals with projects and Git worktrees. A local-first desktop app that coordinates Codex, Claude Code, Gemini CLI, OpenCode, and custom executables.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cli-masterd"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": null
    }
  }
}
