+    #[test]
+    fn delayed_pre_spawn_cache_cannot_prune_a_new_live_root() {
+        let root = record(100, 1, 100, "root");
+        let mut tree = ProcessTree::with_root_for_test(root.clone(), 8);
+        let older = tree
+            .last_snapshot_completed_at
+            .checked_sub(Duration::from_millis(1))
+            .unwrap();
+        let cache = Mutex::new(Some(snapshot(older, Vec::new())));
+        let refreshed = process_snapshot_with(
+            tree.scan_timeout,
+            false,
+            Some(tree.last_snapshot_completed_at),
+            &cache,
+            |_| {
+                assert!(
+                    cache.try_lock().is_some(),
+                    "scan must not hold the cache lock"
+                );
+                Ok(vec![root])
+            },
+        )
+        .expect("an old cached scan should cause a fresh scan");
+
+        let tracked = tree.absorb_snapshot(&refreshed).unwrap();
+
+        assert_eq!(tracked.len(), 1);
+        assert_eq!(tracked[0].pid, Pid::from_raw(100));
+        assert!(tree.known.contains_key(&100));
+    }
